{
  "schemaVersion": 1,
  "entry": "welcome",
  "nodes": [
    {
      "id": "welcome",
      "type": "menu",
      "lines": [
        "COINLINE INFOLINE",
        "1 Weather",
        "0 Exit"
      ],
      "prompt": "CoinLine InfoLine. Press one for weather, or zero to exit.",
      "choices": [
        {
          "digit": "1",
          "label": "Wx",
          "target": "fetch"
        },
        {
          "digit": "0",
          "label": "Exit",
          "target": "end"
        }
      ],
      "onTimeout": "end"
    },
    {
      "id": "fetch",
      "type": "provider",
      "operation": "weather.current",
      "args": {
        "site": "demo-harbour"
      },
      "bind": "wx",
      "onOk": "weather",
      "onUnavailable": "unavailable"
    },
    {
      "id": "weather",
      "type": "message",
      "lines": [
        "{{wx.displayTitle}}",
        "{{wx.place}}",
        "{{wx.temperatureText}}",
        "As of {{wx.localTime}}"
      ],
      "prompt": "{{wx.displayTitle}} for {{wx.place}}, {{wx.temperatureText}}, as of {{wx.localTime}}. Press zero to return.",
      "continue": {
        "digit": "0",
        "label": "Back",
        "target": "welcome"
      },
      "onTimeout": "end"
    },
    {
      "id": "unavailable",
      "type": "message",
      "lines": [
        "DEMO WX UNAVAILABLE"
      ],
      "prompt": "Demo weather is unavailable. Press zero to return.",
      "continue": {
        "digit": "0",
        "label": "Back",
        "target": "welcome"
      },
      "onTimeout": "end"
    },
    {
      "id": "end",
      "type": "end",
      "prompt": "Goodbye."
    }
  ]
}
