        "{{regional-draw.game}}",
        "{{regional-draw.drawDate}}",
        "{{regional-draw.numbers}}",
        "{{regional-draw.bonus}}",
        "{{regional-draw.source}}"
      ],
      "prompt": "{{regional-draw.game}}. {{regional-draw.drawDate}}. {{regional-draw.numbers}}. {{regional-draw.bonus}}. {{regional-draw.source}}. Press zero to return.",
      "continue": {
        "digit": "0",
        "label": "Back",
        "target": "lottery-menu"
      },
      "onTimeout": "end"
    },
    {
      "id": "help",
      "type": "provider",
      "operation": "assistant.answer",
      "args": {
        "question": "adsi"
      },
      "bind": "help",
      "onOk": "help-result",
      "onUnavailable": "unavailable"
    },
    {
      "id": "help-result",
      "type": "message",
      "lines": [
        "{{help.displayTitle}}",
        "{{help.answer}}",
        "{{help.source}}"
      ],
      "prompt": "{{help.displayTitle}}. {{help.answer}}. {{help.source}}. Press zero to return.",
      "continue": {
        "digit": "0",
        "label": "Back",
        "target": "welcome"
      },
      "onTimeout": "end"
    },
    {
      "id": "unavailable",
      "type": "message",
      "lines": [
        "SERVICE UNAVAILABLE",
        "0 Back"
      ],
      "prompt": "This service is unavailable. Press zero to return.",
      "continue": {
        "digit": "0",
        "label": "Back",
        "target": "welcome"
      },
      "onTimeout": "end"
    },
    {
      "id": "end",
      "type": "end",
      "prompt": "Goodbye."
    }
  ]
}
